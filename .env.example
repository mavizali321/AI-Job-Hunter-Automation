# Database
DATABASE_URL=postgresql+psycopg2://jobhunter:jobhunter@localhost:5432/jobhunter
# For local dev/testing without Postgres:
# DATABASE_URL=sqlite:///./jobhunter.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-me-to-a-random-string
DASHBOARD_PASSWORD=change-me

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_RECIPIENT=
WHATSAPP_APP_SECRET=

# LLM (OpenAI-compatible)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Worker
WORKER_TOKEN=change-me-to-a-random-string
BROWSER_PROFILE_DIR=./browser_profile

# Scheduling
SEARCH_WINDOW_DAYS=7
APPROVAL_THRESHOLD=80
REVIEW_THRESHOLD=70
TIMEZONE=Asia/Karachi

# Discovery adapters (comma-separated lists)
GREENHOUSE_BOARD_TOKENS=
LEVER_COMPANY_SLUGS=
ASHBY_COMPANY_SLUGS=
CAREER_PAGE_URLS=
